% =====================================================================
%  beamerthemewarmpaper.sty · Editorial Warm Minimalist 学术汇报主题
%  用法：\documentclass[aspectratio=169,10pt,t]{beamer}
%        \usetheme{warmpaper}
%        \decksections{Background,Method,Experiments,Conclusion}
%  编译：xelatex（两遍）。依赖：ctex unicode-math booktabs colortbl tikz（TeX Live basic 可用）
%  字体：PingFang SC（macOS）。其他系统改 \warmcjkfont / \warmlatinfont，见 SKILL.md。
% =====================================================================
\ProvidesPackage{beamerthemewarmpaper}[2026/01/01 Warm Paper academic theme]
\mode<presentation>

% ---------- 0. 字体 ----------
\providecommand{\warmlatinfont}{PingFang SC}
\providecommand{\warmcjkfont}{PingFang SC}
\usefonttheme{professionalfonts}
\RequirePackage[fontset=none,scheme=plain]{ctex}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\defaultfontfeatures{Ligatures=TeX}
\newcommand{\warm@latinfeatures}{UprightFont={* Regular},BoldFont={* Semibold},
  ItalicFont={* Regular},ItalicFeatures={FakeSlant=0.16},
  BoldItalicFont={* Semibold},BoldItalicFeatures={FakeSlant=0.16}}
\newcommand{\warm@cjkfeatures}{UprightFont={* Regular},BoldFont={* Semibold},
  ItalicFont={* Regular},BoldItalicFont={* Semibold}}
\begingroup\edef\x{\endgroup
  \noexpand\setmainfont{\warmlatinfont}[\warm@latinfeatures]%
  \noexpand\setsansfont{\warmlatinfont}[\warm@latinfeatures]%
  \noexpand\setCJKmainfont{\warmcjkfont}[\warm@cjkfeatures]%
  \noexpand\setCJKsansfont{\warmcjkfont}[\warm@cjkfeatures]%
  \noexpand\setCJKmonofont{\warmcjkfont}}\x
\IfFontExistsTF{Menlo}{\setmonofont{Menlo}[Scale=0.86]}{}
\IfFontExistsTF{STIX Two Math}{\setmathfont{STIX Two Math}}{\setmathfont{Latin Modern Math}}

% ---------- 1. Warm Paper Tokens ----------
\definecolor{BgPaper}{HTML}{FAF8F5}
\definecolor{InkMain}{HTML}{18181B}
\definecolor{InkMuted}{HTML}{71717A}
\definecolor{AccentTerra}{HTML}{C85A32}
\definecolor{CardSand}{HTML}{F0ECE1}
\definecolor{BorderWarm}{HTML}{D6D1C7}
\colorlet{TerraTint}{AccentTerra!9!BgPaper}
% 换强调色（整套只允许一个强调色）：\setaccent{2F5D8A}
\newcommand{\setaccent}[1]{\definecolor{AccentTerra}{HTML}{#1}\colorlet{TerraTint}{AccentTerra!9!BgPaper}}

% ---------- 2. Beamer 外观 ----------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{background canvas}{\color{BgPaper}\vrule width\paperwidth height\paperheight}
\setbeamercolor{normal text}{fg=InkMain,bg=BgPaper}
\setbeamercolor{structure}{fg=AccentTerra}
\setbeamercolor{alerted text}{fg=AccentTerra}
\setbeamercolor{frametitle}{fg=InkMain,bg=}
\setbeamercolor{framesubtitle}{fg=InkMuted}
\setbeamerfont{frametitle}{size=\fontsize{15}{18}\selectfont,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{12.5}{16}\selectfont,series=\mdseries}
\setbeamertemplate{blocks}[default]
\setbeamertemplate{itemize items}{\raisebox{.25ex}{\color{AccentTerra}\rule{.42em}{.42em}}}
\setbeamertemplate{itemize subitem}{\raisebox{.3ex}{\color{InkMuted}\rule{.32em}{.32em}}}
\setbeamertemplate{enumerate items}{\color{AccentTerra}\bfseries\insertenumlabel.}
\setlength{\leftmargini}{1.1em}
\setbeamersize{text margin left=0.9cm,text margin right=0.9cm}

% ---------- 3. 帧标题：English ｜ 中文 + 极细分割线 ----------
\setbeamertemplate{frametitle}{%
  \vskip 0.34cm
  \usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle
  \ifx\insertframesubtitle\empty\else
    {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
     \hspace{0.35em}{\color{AccentTerra}｜}\hspace{0.2em}\insertframesubtitle}%
  \fi\par
  \vskip 0.16cm
  {\color{BorderWarm}\hrule height 0.4pt}%
  \vskip 0.06cm}
\newcommand{\bititle}[2]{\frametitle{#1}\framesubtitle{#2}}

% ---------- 4. 底栏：左 = 章节进度，右 = X / N ----------
\newcommand{\warm@sections}{}
\newcommand{\decksections}[1]{\renewcommand{\warm@sections}{#1}}
\newcommand{\decktotal}{\inserttotalframenumber}
\newcommand{\sectiontrail}{%
  \ifx\warm@sections\empty\else
  \foreach \s [count=\i] in \warm@sections {%
    \ifnum\i>1 {\color{BorderWarm}\hspace{0.45em}/\hspace{0.45em}}\fi
    \ifnum\i=\value{section}{\color{AccentTerra}\bfseries\s}\else{\color{InkMuted}\s}\fi}%
  \fi}
\setbeamertemplate{footline}{%
  \fontsize{6.5}{8}\selectfont
  \hbox to\paperwidth{\hspace{0.9cm}%
    \sectiontrail\hfill
    {\color{InkMuted}\insertframenumber\,/\,\decktotal}\hspace{0.9cm}}%
  \vskip 0.32cm}
% ---------- 5. 字号令牌（中文行距约 1.4） ----------
\newcommand{\bodysize}{\fontsize{9}{12.6}\selectfont}
\newcommand{\densesize}{\fontsize{8}{11}\selectfont}
\newcommand{\notesize}{\fontsize{7}{9.4}\selectfont}
\newcommand{\capsize}{\fontsize{6.5}{8.6}\selectfont}
\newcommand{\cardtitlesize}{\fontsize{9.5}{12}\selectfont}
\newcommand{\statementsize}{\fontsize{17}{25}\selectfont}

% ---------- 6. 紧凑公式 ----------
\newcommand{\tightdisplay}{%
  \setlength{\abovedisplayskip}{4pt}\setlength{\belowdisplayskip}{4pt}%
  \setlength{\abovedisplayshortskip}{2pt}\setlength{\belowdisplayshortskip}{2pt}}
\AtBeginDocument{\appto\normalsize{\tightdisplay}\appto\small{\tightdisplay}%
  \appto\footnotesize{\tightdisplay}\appto\scriptsize{\tightdisplay}}
\newsavebox{\eqbox}
\newcommand{\eqline}[1]{%
  \par\vspace{3pt}%
  \sbox{\eqbox}{$\displaystyle #1$}%
  \ifdim\wd\eqbox>\linewidth\sbox{\eqbox}{\resizebox{\linewidth}{!}{\usebox{\eqbox}}}\fi
  \noindent\makebox[\linewidth][c]{\usebox{\eqbox}}\par\vspace{3pt}}

% ---------- 7. 卡片系统 ----------
\newlength{\cardpad}\setlength{\cardpad}{6pt}
\newlength{\cardgap}\setlength{\cardgap}{5pt}
\newlength{\leftrulew}\setlength{\leftrulew}{2.6pt}
\newsavebox{\cardbox}
\newcommand{\cardtitle}[1]{%
  \ifblank{#1}{}{{\raggedright\cardtitlesize\bfseries\color{InkMain}#1\par}\vspace{2pt}}}
\newcommand{\cardopen}[2]{%
  \begin{lrbox}{\cardbox}%
  \ifblank{#2}{\begin{minipage}[t]{#1}}{\begin{minipage}[t][#2][t]{#1}}%
  \bodysize\color{InkMain}\setlength{\parskip}{2pt}}
\newcommand{\cardclose}{\end{minipage}\end{lrbox}}
\NewDocumentEnvironment{warmcard}{O{\linewidth} O{} m}
  {\par\noindent\cardopen{\dimexpr#1-2\cardpad-2pt\relax}{#2}\cardtitle{#3}}
  {\cardclose
   {\setlength{\fboxsep}{\cardpad}\setlength{\fboxrule}{1pt}%
    \fcolorbox{BorderWarm}{CardSand}{\usebox{\cardbox}}}\par\vspace{\cardgap}}
\NewDocumentEnvironment{papercard}{O{\linewidth} O{} m}
  {\par\noindent\cardopen{\dimexpr#1-2\cardpad-2pt\relax}{#2}\cardtitle{#3}}
  {\cardclose
   {\setlength{\fboxsep}{\cardpad}\setlength{\fboxrule}{1pt}%
    \fcolorbox{BorderWarm}{BgPaper}{\usebox{\cardbox}}}\par\vspace{\cardgap}}
\newcommand{\rulebox}[2]{%
  \setlength{\fboxsep}{\cardpad}%
  \sbox{\cardbox}{\colorbox{#2}{\usebox{\cardbox}}}%
  \noindent{\color{#1}\vrule width\leftrulew height\ht\cardbox depth\dp\cardbox}%
  \usebox{\cardbox}\par\vspace{\cardgap}}
\NewDocumentEnvironment{callout}{O{\linewidth} O{} m}
  {\par\noindent\cardopen{\dimexpr#1-2\cardpad-\leftrulew\relax}{#2}\cardtitle{#3}}
  {\cardclose\rulebox{AccentTerra}{CardSand}}
\NewDocumentEnvironment{takeaway}{O{\linewidth}}
  {\par\noindent\cardopen{\dimexpr#1-2\cardpad-\leftrulew\relax}{}}
  {\cardclose\rulebox{AccentTerra}{TerraTint}}
\NewDocumentEnvironment{fignote}{O{\linewidth}}
  {\par\noindent\begin{minipage}[t]{#1}%
   {\color{BorderWarm}\hrule height .4pt}\vspace{3pt}%
   \notesize\color{InkMuted}{\color{AccentTerra}\rule[.2ex]{.5em}{.5pt}}\hspace{.4em}}
  {\end{minipage}\par}

% ---------- 8. 安全插图 ----------
\newsavebox{\imgbox}
\newlength{\capwidth}
\NewDocumentCommand{\safeimg}{O{} m m}{%
  \par\noindent
  \sbox{\imgbox}{\includegraphics[width=\linewidth,height=.42\textheight,keepaspectratio,#1]{#2}}%
  \setlength{\capwidth}{\wd\imgbox}%
  \ifdim\capwidth<.6\linewidth\setlength{\capwidth}{.6\linewidth}\fi
  \ifdim\capwidth>\linewidth\setlength{\capwidth}{\linewidth}\fi
  \makebox[\linewidth][c]{\begin{minipage}[t]{\capwidth}
    \centering\usebox{\imgbox}%
    \ifblank{#3}{}{\par\vspace{3pt}\raggedright\capsize\color{InkMuted}#3}%
  \end{minipage}}\par\vspace{\cardgap}}
\newcommand{\figsrc}[1]{\par{\capsize\color{InkMuted}\raggedright#1\par}}

% ---------- 9. 行内宏 ----------
\newcommand{\key}[1]{\leavevmode{\color{AccentTerra}\bfseries#1}}
\newcommand{\muted}[1]{\leavevmode{\color{InkMuted}#1}}
\newcommand{\dotsep}{\enspace$\cdot$\enspace}
\newcommand{\file}[1]{{\ttfamily\detokenize{#1}}}
\newcommand{\speedup}[1]{\leavevmode{\color{AccentTerra}\bfseries\fontsize{11}{13}\selectfont#1}}
\newcommand{\flowarrow}{{\color{AccentTerra}$\longrightarrow$}}
\newcommand{\downarrowc}{\par\centerline{\color{AccentTerra}$\downarrow$}\par}
\newcommand{\stepnum}[1]{\tikz[baseline=(n.base)]\node[circle,fill=AccentTerra,
  inner sep=0pt,minimum size=1.15em,text=BgPaper,font=\fontsize{7}{7}\bfseries\selectfont](n){#1};}
\newcommand{\gaparrow}[1][1.2cm]{\vspace*{#1}\noindent\makebox[\linewidth][c]{\color{AccentTerra}$\rightarrow$}\par}
\newcommand{\contrastbar}[4]{%
  \begin{callout}{}\densesize%
  \begin{minipage}[t]{.33\linewidth}\raggedright\muted{\textbf{#1}：#2}\end{minipage}%
  \hfill\begin{minipage}[t]{.05\linewidth}\centering\flowarrow\end{minipage}\hfill
  \begin{minipage}[t]{.59\linewidth}\raggedright\key{#3}：#4\end{minipage}%
  \end{callout}}
\newcolumntype{H}{>{\columncolor{TerraTint}\color{AccentTerra}\bfseries}r}
\setlength{\aboverulesep}{0pt}\setlength{\belowrulesep}{0pt}
\renewcommand{\arraystretch}{1.45}
\newcommand{\warmrule}{\arrayrulecolor{BorderWarm}}

% ---------- 10. 封面（\titlepage）与陈述页 ----------
\newcommand{\warm@kicker}{}\newcommand{\coverkicker}[1]{\renewcommand{\warm@kicker}{#1}}
\newcommand{\warm@meta}{}\newcommand{\covermeta}[1]{\renewcommand{\warm@meta}{#1}}
\newcommand{\warm@ref}{}\newcommand{\coverref}[1]{\renewcommand{\warm@ref}{#1}}
\newcommand{\metasep}{\hspace{0.5em}｜\hspace{0.5em}}
\setbeamertemplate{title page}{%
  \vspace*{1.05cm}
  \ifx\warm@kicker\empty\else
    {\fontsize{8}{10}\selectfont\color{AccentTerra}\bfseries\warm@kicker\par}\vspace{6pt}\fi
  {\fontsize{23}{28}\selectfont\bfseries\color{InkMain}\inserttitle\par}
  \vspace{8pt}{\color{AccentTerra}\rule{2.4cm}{1.6pt}\par}\vspace{10pt}
  \ifx\insertsubtitle\@empty\else{\fontsize{13}{17}\selectfont\insertsubtitle\par}\vspace{14pt}\fi
  \ifx\warm@meta\empty\else{\fontsize{8.5}{12}\selectfont\color{InkMuted}\warm@meta\par}\fi
  \vfill
  \ifx\warm@ref\empty\else
    \begin{callout}[.86\linewidth]{}{\densesize\warm@ref\par}\end{callout}\fi
  \vspace*{0.7cm}}
% 陈述页：一句话撑满一页（章节转场 / 核心论点）
\NewDocumentCommand{\statementpage}{m o}{%
  \vspace*{\fill}
  {\color{AccentTerra}\rule{1.2cm}{1.6pt}\par}\vspace{10pt}
  {\statementsize\bfseries\raggedright #1\par}
  \IfValueT{#2}{\vspace{10pt}{\notesize\color{InkMuted}#2\par}}
  \vspace*{\fill}}

\mode<all>
